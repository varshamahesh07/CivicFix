# Copy to .env (or export these). Never commit real secrets.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///civicfix.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local dev can use the same-site Lax cookie. Cross-site production needs SameSite=None and HTTPS.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0
DEMO_SEED=1

# Optional AI / ML Model Weights Paths
# VISION_MODEL_PATH=path/to/vision_weights.pt
# NLP_MODEL_PATH=path/to/nlp_model/
